# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://project_id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=publishable_key

# Api
NEXT_PUBLIC_API_URL=http://localhost:3100
NEXT_PUBLIC_API_PREFIX="api"

# App
NEXT_PUBLIC_APP_NAME="Personal OS"
NEXT_OS="web"
NEXT_ENV="development"
NEXT_PUBLIC_URL=http://localhost:3000
# URL publica de la app; la usan metadata, robots y sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Origen de la landing (repo personal-os-landing). Sin valor usa la publicada.
NEXT_PUBLIC_LANDING_URL=https://personal-os-landing-six.vercel.app

# Web Push (public VAPID key — generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="VAPID_PUBLIC_KEY"

# Logo.dev publishable key for institution search previews only.
NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY="LOGO_DEV_PUBLISHABLE_KEY"

# Sentry (opcional; sin DSN la SDK no se inicializa). El DSN es publico: solo
# permite enviar eventos a ese proyecto.
# NEXT_PUBLIC_SENTRY_DSN="https://your-key@o0.ingest.sentry.io/0"
# SENTRY_TRACES_SAMPLE_RATE=0.1
# El sample rate del cliente es publico porque el navegador lo lee en el build.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Solo para subir source maps en el build; sin token el build no falla.
# SENTRY_AUTH_TOKEN="YOUR_SENTRY_AUTH_TOKEN"
# SENTRY_ORG="collado-studios"
# SENTRY_PROJECT="personal-os-web"
