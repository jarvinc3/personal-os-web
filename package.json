{
  "name": "personal-os-web",
  "version": "0.56.1",
  "description": "Cliente web de Personal OS: gestiona finanzas, agenda, proyectos y más en una sola app.",
  "author": "jarvinc3",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/alias-register.mjs --test --experimental-strip-types src/config/**/*.spec.ts src/modules/**/*.spec.ts src/shared/**/*.spec.ts",
    "test:coverage": "c8 --all --include=\"src/**/*.ts\" --include=\"src/**/*.tsx\" --exclude=\"**/*.spec.ts\" --exclude=\"**/*.d.ts\" --check-coverage --lines 18 --branches 72 --functions 46 --statements 18 --reporter=text-summary node --import ./scripts/alias-register.mjs --test --experimental-strip-types \"src/**/*.spec.ts\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@ncdai/react-wheel-picker": "^1.2.3",
    "@sentry/nextjs": "11.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.3",
    "@vercel/analytics": "1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "date-fns": "4.1.0",
    "decimal.js-light": "^2.5.1",
    "framer-motion": "^13.5.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.1",
    "socket.io-client": "^4.8.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^11.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@code-inspector/webpack": "2.0.9",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.1.7",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.9.3"
  }
}
