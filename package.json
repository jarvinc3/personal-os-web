{
  "name": "personal-os-web",
  "version": "0.100.0",
  "description": "Cliente web de Personal OS: gestiona finanzas, agenda, proyectos y más en una sola app.",
  "author": "jarvinc3",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "env:pull": "infisical export --env=dev --path=/web > .env",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "api:contract": "node --experimental-strip-types src/config/api-contract/sync-contract-cli.ts",
    "api:contract:check": "node --experimental-strip-types src/config/api-contract/check-contract-cli.ts",
    "api:generate": "node --experimental-strip-types src/config/api-contract/generate-cli.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "typecheck": "pnpm api:generate && tsc --noEmit",
    "test": "node --import ./scripts/test-env.mjs --import ./scripts/alias-register.mjs --import ./scripts/tsx-register.mjs --test --experimental-strip-types src/config/**/*.spec.ts src/modules/**/*.spec.ts src/shared/**/*.spec.ts",
    "test:coverage": "c8 --all --include=\"src/**/*.ts\" --include=\"src/**/*.tsx\" --exclude=\"**/*.spec.ts\" --exclude=\"**/*.d.ts\" --exclude=\"src/config/api-contract/api-schema*.ts\" --check-coverage --lines 28 --branches 80 --functions 47 --statements 28 --reporter=text-summary node --import ./scripts/test-env.mjs --import ./scripts/alias-register.mjs --import ./scripts/tsx-register.mjs --test --experimental-strip-types \"src/**/*.spec.ts\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.2",
    "@ncdai/react-wheel-picker": "^1.2.3",
    "@sentry/nextjs": "11.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@vercel/analytics": "1.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "4.1.0",
    "decimal.js-light": "^2.5.1",
    "framer-motion": "^13.5.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "socket.io-client": "^4.8.4",
    "sonner": "^1.7.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@code-inspector/webpack": "2.0.9",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.9.3"
  }
}
